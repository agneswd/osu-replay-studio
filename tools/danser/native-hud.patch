+// SetPremultiplied selects sprites whose texture already contains premultiplied color.
+func (batch *QuadBatch) SetPremultiplied(value bool) {
+	batch.Flush()
+	var flag int32
+	if value {
+		flag = 1
+	}
+	batch.shader.SetUniform("studioPremultiplied", flag)
